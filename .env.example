# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in what you have. EVERY key is optional:
# a source with no key simply disables itself and the run continues without it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (storage) ───────────────────────────────────────────────────────
# Without these, tools still return live results but nothing is persisted/cached.
SUPABASE_URL=
SUPABASE_KEY=                 # service_role key (server-side) recommended
SUPABASE_DB_URL=              # optional: direct/pooler Postgres URI, admin-only —
                               # needed solely to run `python -m scraper.apply_migration`
                               # (PostgREST/SUPABASE_KEY can't run DDL). Get it from
                               # Supabase Dashboard -> Connect -> Direct -> "Session pooler".

# ── Behavior ─────────────────────────────────────────────────────────────────
FRESHNESS_HOURS=24            # serve cached rows instead of re-scraping within this window
HTTP_MAX_CONCURRENCY=8        # global cap on simultaneous outbound requests
HTTP_TIMEOUT_SECONDS=20
USER_AGENT=scraper-mcp/0.1 (+https://github.com/; research bot; contact=carlosglzg02@gmail.com)
# Optional comma-lists to force-enable/disable sources by name, e.g. DISABLED_SOURCES=trends_google
ENABLED_SOURCES=
DISABLED_SOURCES=

# ── Events ───────────────────────────────────────────────────────────────────
TICKETMASTER_API_KEY=         # free: https://developer.ticketmaster.com  (Discovery API)

# ── Web research / search ────────────────────────────────────────────────────
# DuckDuckGo needs no key. These improve quality when present (both have free tiers).
TAVILY_API_KEY=               # free ~1k/mo: https://tavily.com
BRAVE_API_KEY=                # free ~2k/mo: https://brave.com/search/api

# ── Trends / content ideas ───────────────────────────────────────────────────
REDDIT_CLIENT_ID=             # free: https://www.reddit.com/prefs/apps (type: script)
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=scraper-mcp/0.1 by u/yourname
YOUTUBE_API_KEY=              # free quota: Google Cloud Console -> YouTube Data API v3
# Hacker News + Google Trends need no keys.

# ── Meta official APIs (OWN-ACCOUNT scope only) ──────────────────────────────
# Requires a Meta Developer app + linked Business/Creator account. See README.
META_APP_ID=
META_APP_SECRET=
IG_ACCESS_TOKEN=              # long-lived user token with instagram_basic + pages perms
IG_BUSINESS_ACCOUNT_ID=       # your IG Business/Creator account id
THREADS_ACCESS_TOKEN=         # long-lived Threads token
THREADS_USER_ID=              # your Threads user id

# ── GHL knowledge base (Google Sheet export) ─────────────────────────────────
# `python -m scraper.kb export` rewrites this sheet daily from Supabase; GHL
# imports it as the bot's knowledge base. Share the sheet with the service
# account's email as an Editor — it has no access until you do.
KB_SHEET_ID=                  # the /d/<THIS>/edit segment of the sheet's URL
KB_SHEET_TAB=events
KB_HORIZON_DAYS=60            # how far ahead to publish
KB_LOCATION=El Paso
GOOGLE_SERVICE_ACCOUNT_JSON=  # the whole service-account key file, as one line
GOOGLE_APPLICATION_CREDENTIALS=  # ...or a path to it, for local runs

# ── Daily Instagram carousel (scraper.social) ─────────────────────────────────
# Every value below has a working default in core/config.py; they are listed so
# a fresh checkout can see what exists. In CI these come from repo Actions
# variables/secrets — and note that a var absent there resolves to an EMPTY
# STRING, not to the default you see in the code, so any setting you add must
# also be added to .github/workflows/ig_daily.yml's env block.
IG_TIMEZONE=America/Denver    # "today" is the local calendar day, not the runner's UTC one
IG_HANDLE=epchisme.com
IG_SLIDES_BUCKET=ig-slides    # private Supabase bucket; Meta fetches signed URLs from it
IG_MIN_SLIDES=4               # floor, not a target: a 3-slide digest reads worse than none
IG_MAX_SLIDES=9               # +1 cover = Instagram's 10-item carousel cap
IG_SLIDE_RETENTION_DAYS=7
IG_SUGGESTED_PUBLISH_HOUR=17  # local hour the build proposes for scheduled_for

# Opt-out posting: a draft nobody cancels or edits by IG_AUTO_APPROVE_HOUR is
# approved automatically and ships on the next publish sweep. Off by default.
# NOT the same as IG_AUTOPOST, which publishes at BUILD time with no review
# window and no Telegram ping at all.
IG_AUTO_APPROVE=false
IG_AUTO_APPROVE_HOUR=17
IG_AUTOPOST=false

# IG_DIGEST_SLOTS="morning:11,evening:18" runs two independently-scheduled
# digests per day. Empty means one unnamed digest.
IG_DIGEST_SLOTS=

# ── Notifications ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Comma-separated. The FIRST entry is where notifications are SENT; the Next.js
# webhook treats the whole list as an allowlist of chats permitted to act on them.
TELEGRAM_CHAT_ID=
# Echoed back by Telegram in the X-Telegram-Bot-Api-Secret-Token header on every
# delivery. It must be IDENTICAL in three places: here, the webhook host's env
# (Vercel), and the value passed to setWebhook. A mismatch 401s every delivery
# with no outward sign except getWebhookInfo's last_error_message — register with
# `python -m scraper.social telegram-webhook --set` and verify with
# `python -m scraper.social check-telegram`.
TELEGRAM_WEBHOOK_SECRET=

# Must be the FINAL host, including www if the site canonicalises to it.
# Telegram does not follow redirects when delivering updates, so a bare apex
# that 308s to www yields a registration that succeeds and then delivers
# nothing. `telegram-webhook --set` refuses to register a redirecting URL.
SITE_BASE_URL=https://www.epchisme.com

# Email is the fallback channel for "Telegram itself is broken" alerts — an
# alert sent over the channel it is reporting on is not an alert.
RESEND_API_KEY=
NOTIFY_ADMIN_EMAIL=
NOTIFY_EMAIL_FROM=
IG_NOTIFY_SECRET=             # signs the token-gated /admin/ig/review/[token] link
IG_NOTIFY_TTL_HOURS=36
